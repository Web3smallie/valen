# Valen frontend — environment variables (copy to .env to override).
# Base URL of the Valen backend API. Default is the Vite dev-server proxy,
# which forwards /api/* to http://localhost:3000. For a deployed backend,
# set the full origin, e.g. VITE_API_BASE=https://api.valen.example.com
VITE_API_BASE=/api
